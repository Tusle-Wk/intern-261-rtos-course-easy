# Ex1 -- các định nghĩa liên quan NVIC priority phải có trong FreeRTOSConfig.h
#
# Điền giá trị vào chỗ <?>. Mỗi dòng phải giải thích được trong buổi vấn đáp.

configPRIO_BITS                                 4
configLIBRARY_LOWEST_INTERRUPT_PRIORITY         15
configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY    5
configASSERT( x )                               if( ( x ) == 0 ) { taskDISABLE_INTERRUPTS(); for( ;; ); }

# ISR_NVIC_PRIO (app/params.h) phải nằm trong khoảng:
#   configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY  <=  ISR_NVIC_PRIO  <=  configLIBRARY_LOWEST_INTERRUPT_PRIORITY
# (số CÀNG NHỎ = ưu tiên phần cứng CÀNG CAO). Giải thích tại sao trong REPORT.md.
